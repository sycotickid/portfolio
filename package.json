{
  "name": "portfolio",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "wrangler types && vite build",
    "preview": "npm run build && wrangler dev",
    "postinstall": "node -e \"const fs=require('fs'),path=require('path');const src=path.join('node_modules','sql.js','dist','sql-wasm.wasm');const dst=path.join('static','sql-wasm.wasm');try{fs.mkdirSync('static',{recursive:true});fs.copyFileSync(src,dst);console.log('sql-wasm.wasm copied');}catch(e){console.warn('Could not copy sql-wasm.wasm:',e.message);}\"",
    "gen": "wrangler types",
    "check": "wrangler types --check",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^25.7.0",
    "svelte": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "wrangler": "^4.81.0"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "^5.0.0",
    "@fontsource-variable/playfair-display": "^5.0.0",
    "@fontsource/jetbrains-mono": "^5.0.0",
    "resend": "^6.12.3",
    "simple-icons": "^16.19.0",
    "sql.js": "^1.12.0"
  },
  "type": "module"
}
